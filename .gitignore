# Виртуальные окружения Python (если создаете их локально на Windows)
venv/
env/
.venv/
.env/

# Кэш Python и скомпилированные файлы
__pycache__/
*.py[cod]
*$py.class

# Переменные окружения (ОЧЕНЬ ВАЖНО: никогда не пушьте реальные пароли)
.env
# Оставляем только шаблон для примера
!/.env.example

# Временные файлы Docker
.docker/
docker-compose.override.yml

# База данных PostgreSQL (если поднимаете локально через volume)
pgdata/

# Логи и кэш
*.log
.pytest_cache/
.coverage
htmlcov/

# Пользовательские загрузки и временные файлы для парсинга (PDF, CSV)
temp/
uploads/
*.pdf
*.csv
*.xlsx
