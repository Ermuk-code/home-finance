# Telegram Bot
BOT_TOKEN=123456:replace-me

# Пользователи Life OS (двое): admin — вы, user — партнёр
ADMIN_TELEGRAM_ID=111111111
ADMIN_NAME=Вы
PARTNER_TELEGRAM_ID=222222222
PARTNER_NAME=Вика

# PostgreSQL
POSTGRES_USER=finance
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finance
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Безопасность веб-интерфейса (JWT) и вход администратора по паролю
JWT_SECRET_KEY=change-me-to-long-random-string
JWT_ALGORITHM=HS256
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Публичный адрес веб-панели (бот присылает ссылку входа по команде /web)
WEB_BASE_URL=http://localhost:8000

# Секрет вебхуков Home Assistant (заголовок X-Webhook-Token). Пусто — вебхуки выключены.
# Сгенерировать: openssl rand -hex 32
HEALTH_WEBHOOK_TOKEN=

# Присылать admin-у уведомление «партнёр взвесился» (без значения веса): true / false
WEIGHT_ADMIN_DIGEST=false

# IP, на котором контейнер публикует порт 8000. Чтобы Home Assistant достучался до вебхука,
# укажите LAN-адрес хоста (например 192.168.1.50) или 0.0.0.0. По умолчанию — только localhost.
APP_BIND_IP=127.0.0.1

# FatSecret Platform API (питание). Consumer Key / Shared Secret из developer console (раздел OAuth 1.0).
# Пусто — интеграция выключена.
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=
# Куда FatSecret вернёт пользователя после «Разрешить». Пусто — WEB_BASE_URL + /api/health/fatsecret/callback
FATSECRET_CALLBACK_URL=
# Часовой пояс «сегодняшнего дня» дневника питания и расписания синхронизации
FATSECRET_TZ=Europe/Moscow

# Бэкапы БД (сервис backup): час запуска по UTC (0 = 03:00 МСК) и срок хранения дампов в днях
BACKUP_HOUR_UTC=0
BACKUP_KEEP_DAYS=14
