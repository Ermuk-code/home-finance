# ==========================================
# 1. Секреты и переменные окружения (КРИТИЧНО)
# ==========================================
# Запрещаем агенту читать реальные пароли, токены бота, JWT и ключи FatSecret/HA.
# При этом .env.example остается открытым, чтобы агент видел структуру настроек.
.env
.env.*
!.env.example
**/secrets.yaml

# ==========================================
# 2. Личные финансовые выписки и отчеты
# ==========================================
# Скрываем ваши банковские и брокерские документы от отправки в контекст LLM
temp/
uploads/
*.pdf
*.csv
*.xlsx
*.xls

# ==========================================
# 3. База данных, дампы и архивы старого кода
# ==========================================
pgdata/
backups/
*.dump
*.sql
*.sql.gz
*.db
*.sqlite
*.sqlite3
legacy-backup*.zip
*.zip
*.tar.gz

# ==========================================
# 4. Виртуальные окружения и кэш Python
# ==========================================
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# ==========================================
# 5. Кэш тестов, линтеров и логи
# ==========================================
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.log
logs/

# ==========================================
# 6. Служебные папки Git, Docker и IDE
# ==========================================
.git/
.docker/
.idea/
.vscode/
.DS_Store
Thumbs.db